PORT=8080
ENV=development
DATABASE_PATH=data/app.db

# Dev
DEV_AUTH_ENABLED=false
# Used as the raw Bearer token when DEV_AUTH_ENABLED=true. Set this to a user ID from the development database.
DEV_USER_ID=

# Required: use a random value of at least 32 bytes. Never commit a real secret.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
