MOBICODE_SERVER_ENV=development
# Opt in only on a trusted local network. Has no effect in production.
MOBICODE_MOBILE_AUTO_PAIR=false
MOBICODE_SERVER_PORT=8080
# Optional canonical address for mobile pairing; otherwise a server LAN IP is discovered.
# MOBICODE_SERVER_BASE_URL=https://mobicode.example.com
MOBICODE_SERVER_DATA_DIR=tmp
MOBICODE_SERVER_SECRET_TOKEN=replace-with-a-random-secret-of-at-least-32-bytes
