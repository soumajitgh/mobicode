# Shared values available to every application.
SHARED_ENV=development

# Server values used only by apps/server.
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_MAX_BODY_BYTES=1048576
SERVER_GRAPHQL_COMPLEXITY=250
LIBSQL_PORT=9081
SERVER_DATABASE_URL=http://localhost:9081
SERVER_DATABASE_STARTUP_TIMEOUT=30s
SERVER_DATABASE_MAX_OPEN_CONNS=1
SERVER_DATABASE_MAX_IDLE_CONNS=1
SERVER_LOG_LEVEL=info
SERVER_LOG_DEVELOPMENT=true

# Mobile-only values belong under the MOBILE_ prefix.
# MOBILE_API_URL=http://localhost:8080
