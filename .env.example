# Server environment variables must use the MOBICODE_SERVER_* prefix.
MOBICODE_SERVER_PORT=8080
# Set true to serve the GraphQL playground to localhost clients.
MOBICODE_SERVER_PLAYGROUND=false
# Use source assets while running make web/watch.
MOBICODE_SERVER_DEV_ASSETS=false

# Mobile environment variables must use the MOBICODE_MOBILE_* prefix.
