{
  "name": "mobicode",
  "version": "0.0.0",
  "description": "A mobile-first coding agent for on-the-go development.",
  "license": "MIT",
  "homepage": "https://github.com/soumajitgh/mobicode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soumajitgh/mobicode.git"
  },
  "bugs": {
    "url": "https://github.com/soumajitgh/mobicode/issues"
  },
  "scripts": {
    "setup": "pnpm install --frozen-lockfile && mise install",
    "dev": "nx run-many --target=dev --projects=server,mobile --parallel=2",
    "mobile:dev": "nx run mobile:dev",
    "server:dev": "nx run server:dev",
    "mobile": "pnpm mobile:dev",
    "server": "pnpm server:dev",
    "server:run": "nx run server:run",
    "deps:up": "nx run server:deps-up",
    "deps:down": "nx run server:deps-down",
    "deps:logs": "nx run server:deps-logs",
    "migration:create": "nx run server:migrate-create"
  },
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "devDependencies": {
    "@babel/runtime": "~7.27.6",
    "@expo/cli": "~56.1.14",
    "@nx/expo": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/react-native": "23.1.1",
    "@nx/workspace": "23.1.1",
    "@swc/helpers": "~0.5.18",
    "@types/react": "^19.2.0",
    "babel-preset-expo": "~56.0.14",
    "nx": "23.1.1",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@expo/metro": "~56.0.0",
    "@expo/metro-runtime": "~56.0.14",
    "@expo/vector-icons": "~15.1.0",
    "expo": "~56.0.0",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-native": "0.85.3",
    "react-native-svg": "15.12.1",
    "react-native-svg-transformer": "~1.5.1",
    "react-native-web": "~0.21.0"
  }
}
