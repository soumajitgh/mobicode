{
  "name": "server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["deps-up"],
      "options": {
        "command": "make dev",
        "cwd": "apps/server"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "nx run server:dev",
        "cwd": "{workspaceRoot}"
      }
    },
    "run": {
      "executor": "nx:run-commands",
      "cache": false,
      "dependsOn": ["deps-up"],
      "options": {
        "command": "make run",
        "cwd": "apps/server"
      }
    },
    "deps-up": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose up -d libsql",
        "cwd": "{workspaceRoot}"
      }
    },
    "deps-down": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose down",
        "cwd": "{workspaceRoot}"
      }
    },
    "deps-logs": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "docker compose logs -f libsql",
        "cwd": "{workspaceRoot}"
      }
    },
    "migrate-create": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "command": "make migrate-create name={args.name}",
        "cwd": "apps/server"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/server"],
      "options": {
        "command": "make build",
        "cwd": "apps/server"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make test",
        "cwd": "apps/server"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make format",
        "cwd": "apps/server"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make lint",
        "cwd": "apps/server"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make check",
        "cwd": "apps/server"
      }
    }
  }
}
