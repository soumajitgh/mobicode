{
  "name": "server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/server",
  "projectType": "application",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make dev",
        "cwd": "apps/server"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/apps/server"],
      "options": {
        "command": "make build",
        "cwd": "apps/server"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make test",
        "cwd": "apps/server"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make format",
        "cwd": "apps/server"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make lint",
        "cwd": "apps/server"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make check",
        "cwd": "apps/server"
      }
    }
  }
}
