package pages

func passwordStrengthLabel(score int) string {
	switch score {
	case 0:
		return "Very weak"
	case 1:
		return "Weak"
	case 2:
		return "Fair"
	case 3:
		return "Good"
	default:
		return "Strong"
	}
}

func passwordStrengthColor(score int) string {
	switch score {
	case 0, 1:
		return "bg-destructive"
	case 2:
		return "bg-amber-400"
	case 3:
		return "bg-lime-400"
	default:
		return "bg-emerald-400"
	}
}

templ PasswordStrength(password string, score int) {
	if password == "" {
		<p class="text-xs text-muted-foreground">Use at least 12 characters.</p>
	} else {
		<div aria-hidden="true" class="flex gap-1">
			for i := 0; i < 5; i++ {
				<span class={ "h-1 flex-1 rounded-full", templ.KV(passwordStrengthColor(score), i <= score), templ.KV("bg-muted", i > score) }></span>
			}
		</div>
		<p class="text-xs text-muted-foreground">Password strength: { passwordStrengthLabel(score) }. Use at least 12 characters.</p>
	}
}
