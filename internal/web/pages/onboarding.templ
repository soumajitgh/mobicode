package pages

import (
	"github.com/soumajitgh/mobicode/internal/web/components/button"
	"github.com/soumajitgh/mobicode/internal/web/components/input"
	"github.com/soumajitgh/mobicode/internal/web/components/label"
	"github.com/soumajitgh/mobicode/internal/web/components/progress"
)

type OnboardingProps struct {
	Step         int
	UserCreated  bool
	UserEmail    string
	CSRFToken    string
	ErrorMessage string
	EmailValue   string
}

templ Onboarding(props OnboardingProps) {
	@Layout("First-Time Setup · MobiCode") {
		<div class="fixed inset-x-0 top-0 z-50">
			@progress.Progress(progress.Props{Value: props.Step, Max: 3, Class: "onboarding-progress w-full", Attributes: templ.Attributes{"aria-label": "Setup progress"}})
		</div>
		<main class="min-h-screen pt-1.5">
			<header class="page-container py-7">
				<span class="text-base font-semibold tracking-tight">MobiCode</span>
			</header>

			if props.Step == 1 {
				<section class="grid w-full gap-14 px-6 pb-20 pt-12 sm:px-10 xl:min-h-[calc(100vh-7rem)] xl:grid-cols-[minmax(0,3fr)_minmax(20rem,1fr)] xl:items-center xl:gap-16 xl:px-16 xl:pb-24 xl:pt-6">
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">First-time setup</p>
						<h1 class="mt-4 text-5xl font-bold tracking-tight sm:text-6xl xl:text-7xl">Welcome to MobiCode.</h1>
						<p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">Set up your administrator account, then you’re ready to work from anywhere.</p>
					</div>
					<div class="w-full">
						if props.UserCreated {
							<h2 class="text-2xl font-semibold tracking-tight">Account created</h2>
							<p class="mt-3 text-sm leading-relaxed text-muted-foreground">Your administrator account is ready. Continue to finish setup.</p>
							if props.UserEmail != "" {
								<p class="mt-6 text-sm font-medium">{ props.UserEmail }</p>
							}
							<div class="mt-8">
								@button.Button(button.Props{Href: "/onboarding?step=2", Size: button.SizeLg, Class: "h-10 w-full"}) { Continue }
							</div>
						} else {
							<h2 class="text-2xl font-semibold tracking-tight">Create administrator</h2>
							<p class="mt-2 text-sm text-muted-foreground">These credentials will be used to sign in.</p>
							if props.ErrorMessage != "" {
								<p role="alert" class="mt-5 text-sm text-destructive">{ props.ErrorMessage }</p>
							}
							<form method="post" action="/onboarding" class="mt-7 flex flex-col gap-5">
								<input type="hidden" name="csrf_token" value={ props.CSRFToken }/>
								<div class="space-y-2">
									@label.Label(label.Props{For: "email"}) { Email address }
									@input.Input(input.Props{ID: "email", Name: "email", Type: "email", Value: props.EmailValue, Placeholder: "admin@example.com", Required: true, Class: "h-10", Attributes: templ.Attributes{"autocomplete": "email"}})
								</div>
								<div class="space-y-2">
									@label.Label(label.Props{For: "password"}) { Password }
									@input.Input(input.Props{ID: "password", Name: "password", Type: "password", Required: true, Class: "h-10", Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": 12, "maxlength": 128, "aria-describedby": "password-strength", "hx-post": "/onboarding/password-strength", "hx-trigger": "input changed delay:450ms", "hx-target": "#password-strength", "hx-swap": "innerHTML", "hx-include": "closest form"}})
									<div id="password-strength" role="status" aria-live="polite" class="space-y-2">
										@PasswordStrength("", 0)
									</div>
								</div>
								<div class="space-y-2">
									@label.Label(label.Props{For: "confirm_password"}) { Confirm password }
									@input.Input(input.Props{ID: "confirm_password", Name: "confirm_password", Type: "password", Required: true, Class: "h-10", Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": 12, "maxlength": 128}})
								</div>
								@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "mt-2 h-10 w-full"}) { Create account and continue }
							</form>
						}
					</div>
				</section>
			}

			if props.Step == 2 {
				<section class="page-container flex min-h-[calc(100vh-8rem)] items-center py-16">
					<div class="max-w-xl">
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Optional · Coming soon</p>
						<h1 class="mt-4 text-4xl font-bold tracking-tight">Pair your phone</h1>
						<p class="mt-4 text-base leading-relaxed text-muted-foreground">Phone pairing is coming soon. You can continue without connecting a device.</p>
						<nav aria-label="Setup navigation" class="mt-10 flex items-center gap-3">
							@button.Button(button.Props{Href: "/onboarding?step=1", Variant: button.VariantOutline, Size: button.SizeLg, Class: "h-10"}) { Back }
							@button.Button(button.Props{Href: "/onboarding?step=3", Size: button.SizeLg, Class: "h-10"}) { Continue }
						</nav>
					</div>
				</section>
			}

			if props.Step == 3 {
				<section class="page-container flex min-h-[calc(100vh-8rem)] items-center py-16">
					<div class="max-w-xl">
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-muted-foreground">Optional · Coming soon</p>
						<h1 class="mt-4 text-4xl font-bold tracking-tight">Connect GitHub</h1>
						<p class="mt-4 text-base leading-relaxed text-muted-foreground">GitHub integration is coming soon. You can finish setup without connecting an account.</p>
						<form method="post" action="/onboarding/finish" class="mt-10 flex items-center gap-3">
							<input type="hidden" name="csrf_token" value={ props.CSRFToken }/>
							@button.Button(button.Props{Href: "/onboarding?step=2", Variant: button.VariantOutline, Size: button.SizeLg, Class: "h-10"}) { Back }
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "h-10"}) { Finish setup }
						</form>
					</div>
				</section>
			}
		</main>
	}
}
