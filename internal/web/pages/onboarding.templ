package pages

import (
	"github.com/soumajitgh/mobicode/internal/web/components/button"
	"github.com/soumajitgh/mobicode/internal/web/components/input"
	"github.com/soumajitgh/mobicode/internal/web/components/label"
	"github.com/soumajitgh/mobicode/internal/web/components/progress"
)

type OnboardingProps struct {
	Step         int
	UserCreated  bool
	UserEmail    string
	CSRFToken    string
	ErrorMessage string
	EmailValue   string
}

templ Onboarding(props OnboardingProps) {
	@Layout("First-Time Setup · MobiCode") {
		<main class="min-h-screen">
			<div class="mx-auto w-full max-w-5xl px-6 pt-8 sm:px-10">
				<div class="mb-4 flex items-center justify-between text-xs text-muted-foreground">
					<span class="font-semibold uppercase tracking-wider text-foreground">MobiCode setup</span>
					<span>Step { props.Step } of 3</span>
				</div>
				@progress.Progress(progress.Props{Value: props.Step, Max: 3, Attributes: templ.Attributes{"aria-label": "Setup progress"}})
			</div>

			<div class="mx-auto w-full max-w-md px-6 pb-20 pt-16 sm:pt-24">
				if props.Step == 1 {
					if props.UserCreated {
						<h1 class="text-3xl font-bold tracking-tight">Account created</h1>
						<p class="mt-3 text-sm leading-relaxed text-muted-foreground">Your administrator account is ready. Continue to finish setting up MobiCode.</p>
						if props.UserEmail != "" {
							<p class="mt-6 text-sm font-medium">{ props.UserEmail }</p>
						}
						<div class="mt-8">
							@button.Button(button.Props{Href: "/onboarding?step=2", Size: button.SizeLg, Class: "h-10 w-full"}) {
								Continue
							}
						</div>
					} else {
						<h1 class="text-3xl font-bold tracking-tight">Create your account</h1>
						<p class="mt-3 text-sm leading-relaxed text-muted-foreground">Set up the first administrator account for MobiCode.</p>

						if props.ErrorMessage != "" {
							<p role="alert" class="mt-6 text-sm text-destructive">{ props.ErrorMessage }</p>
						}

						<form method="post" action="/onboarding" class="mt-8 flex flex-col gap-5">
							<input type="hidden" name="csrf_token" value={ props.CSRFToken }/>
							<div class="space-y-2">
								@label.Label(label.Props{For: "email"}) { Email address }
								@input.Input(input.Props{ID: "email", Name: "email", Type: "email", Value: props.EmailValue, Placeholder: "admin@example.com", Required: true, Class: "h-10", Attributes: templ.Attributes{"autocomplete": "email", "autofocus": true}})
							</div>
							<div class="space-y-2">
								@label.Label(label.Props{For: "password"}) { Password }
								@input.Input(input.Props{ID: "password", Name: "password", Type: "password", Required: true, Class: "h-10", Attributes: templ.Attributes{"autocomplete": "new-password", "minlength": 12, "maxlength": 128}})
								<p class="text-xs text-muted-foreground">Use at least 12 characters.</p>
							</div>
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "mt-2 h-10 w-full"}) {
								Create account and continue
							}
						</form>
					}
				}

				if props.Step == 2 {
					<h1 class="text-3xl font-bold tracking-tight">Pair your phone</h1>
					<p class="mt-3 text-sm leading-relaxed text-muted-foreground">Phone pairing is coming soon. You can continue without connecting a device.</p>
					<p class="mt-8 text-xs text-muted-foreground">Optional · No action needed</p>
					<nav aria-label="Setup navigation" class="mt-8 flex items-center justify-between gap-3">
						@button.Button(button.Props{Href: "/onboarding?step=1", Variant: button.VariantOutline, Size: button.SizeLg, Class: "h-10"}) { Back }
						@button.Button(button.Props{Href: "/onboarding?step=3", Size: button.SizeLg, Class: "h-10"}) { Continue }
					</nav>
				}

				if props.Step == 3 {
					<h1 class="text-3xl font-bold tracking-tight">Connect GitHub</h1>
					<p class="mt-3 text-sm leading-relaxed text-muted-foreground">GitHub integration is coming soon. You can finish setup without connecting an account.</p>
					<p class="mt-8 text-xs text-muted-foreground">Optional · No action needed</p>
					<form method="post" action="/onboarding/finish" class="mt-8 flex items-center justify-between gap-3">
						<input type="hidden" name="csrf_token" value={ props.CSRFToken }/>
						@button.Button(button.Props{Href: "/onboarding?step=2", Variant: button.VariantOutline, Size: button.SizeLg, Class: "h-10"}) { Back }
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg, Class: "h-10"}) { Finish setup }
					</form>
				}
			</div>
		</main>
	}
}
